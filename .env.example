DATABASE_URL=jdbc:postgresql://localhost:5432/ielts_center
DATABASE_USERNAME=ielts
DATABASE_PASSWORD=ielts
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWK_SET_URI=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
STUDENT_APP_URL=http://localhost:3000
PORT=8080
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=KEEP_THIS_BACKEND_ONLY
FILE_STORAGE_PROVIDER=LOCAL
FILE_STORAGE_MAX_UPLOAD_BYTES=52428800
FILE_STORAGE_MAX_FILE_SIZE=50MB
FILE_STORAGE_MAX_REQUEST_SIZE=55MB
FILE_STORAGE_LOCAL_DIRECTORY=./data/uploads
SUPABASE_STORAGE_BUCKET=learning-library
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_IMPORT_MODELS=nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3.5-lightning-30b-a3b,mistralai/mistral-nemotron
NVIDIA_CHAT_MODELS=nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3.5-lightning-30b-a3b,mistralai/mistral-nemotron
NVIDIA_QUIZ_MODELS=nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3.5-lightning-30b-a3b,mistralai/mistral-nemotron
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_IMPORT_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash,gemini-flash-latest
GEMINI_CHAT_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash,gemini-flash-latest
GEMINI_QUIZ_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash,gemini-flash-latest
AI_IMPORT_PROVIDERS=GEMINI,NVIDIA
AI_CHAT_PROVIDERS=GEMINI,NVIDIA
AI_QUIZ_PROVIDERS=GEMINI,NVIDIA
AI_CONNECT_TIMEOUT_SECONDS=10
AI_IMPORT_TIMEOUT_SECONDS=120
AI_CHAT_TIMEOUT_SECONDS=30
AI_QUIZ_TIMEOUT_SECONDS=60
AI_MAX_RETRIES_PER_MODEL=1
AI_INITIAL_BACKOFF_MILLIS=250
AI_MAX_BACKOFF_MILLIS=2000
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_SECONDS=30
ADMIN_APPROVAL_EMAIL=admin@example.com
MANAGEMENT_APP_URL=http://localhost:5174
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=admin@example.com
MAIL_PASSWORD=GOOGLE_APP_PASSWORD
MAIL_FROM=admin@example.com

# SePay eInvoice Sandbox (server-side only)
SEPAY_EINVOICE_SANDBOX_CLIENT_ID=
SEPAY_EINVOICE_SANDBOX_CLIENT_SECRET=
# Backward-compatible Sandbox aliases:
# SEPAY_EINVOICE_CLIENT_ID=
# SEPAY_EINVOICE_CLIENT_SECRET=

# SePay eInvoice Production (do not reuse Sandbox credentials)
SEPAY_EINVOICE_PRODUCTION_CLIENT_ID=
SEPAY_EINVOICE_PRODUCTION_CLIENT_SECRET=

# Safety mode: receive payments and create SePay drafts, but never issue them.
# Set to false only after explicit approval to enable CQT issuance in Production.
SEPAY_EINVOICE_DRAFT_ONLY=true

# At least 32 characters; keep stable after encrypting secrets in the database
SEPAY_MASTER_KEY=

# Live Sandbox smoke test gates (never enable mutating tests in Production)
SEPAY_SANDBOX_INTEGRATION_TEST=false
SEPAY_SANDBOX_MUTATING_TEST=false

# Durable Writing evaluation worker (disable when running API-only instances)
WRITING_EVALUATION_ENABLED=true
WRITING_EVALUATION_POLL_MILLIS=10000
WRITING_EVALUATION_DAILY_LIMIT=5
# Keep AI Speaking Examiner isolated until its UI and evaluation pipeline are production-ready.
AI_SPEAKING_EXAMINER_ENABLED=false
AI_SPEAKING_EXAMINER_PROMPT_VERSION=speaking-examiner-v1
AI_SPEAKING_EXAMINER_RUBRIC_VERSION=ielts-speaking-public-v1
AI_SPEAKING_EXAMINER_FEATURE_EXTRACTOR_VERSION=unconfigured
# Speaches OpenAI-compatible speech runtime. Use http://speaches:8000 when the backend runs in Compose.
SPEECH_SERVICE_BASE_URL=http://localhost:8000
SPEECH_STT_MODEL=Systran/faster-distil-whisper-small.en
SPEECH_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
SPEECH_TTS_VOICE=bf_emma
SPEECH_CONNECT_TIMEOUT=3s
SPEECH_READ_TIMEOUT=120s
# WebM/Opus recording limits enforced by the server after inspecting the container.
SPEAKING_AUDIO_STORAGE_BUCKET=speaking-audio-private
SPEAKING_AUDIO_MAX_UPLOAD_BYTES=10485760
SPEAKING_AUDIO_MAX_DURATION_SECONDS=180
# Adaptive Learning is an optional bounded module. Keep disabled until the
# Reading question/content mappings have been reviewed for the target cohort.
ADAPTIVE_LEARNING_ENABLED=false
